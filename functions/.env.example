# Copy this file to .env.<your-firebase-project-id> before deploying Functions.
LABOR_CONTROL_PROJECT_ID=your-firebase-project-id
LABOR_TARGET_PROJECT_ID=your-firebase-project-id
LABOR_FIREBASE_WEB_CONFIG={"apiKey":"your-firebase-web-api-key","authDomain":"your-project-id.firebaseapp.com","projectId":"your-project-id","storageBucket":"your-project-id.firebasestorage.app","messagingSenderId":"your-messaging-sender-id","appId":"your-firebase-web-app-id","measurementId":"your-optional-ga4-measurement-id"}
GA4_PROPERTY_ID=
