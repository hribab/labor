{
  "name": "labor",
  "description": "Free, open-source autonomous product builder that generates, deploys, releases, and manages software in your cloud.",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "license": "AGPL-3.0-only",
  "homepage": "https://uselabor.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hribab/labor.git"
  },
  "bugs": {
    "url": "https://github.com/hribab/labor/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "firebase",
    "open-source",
    "product-builder"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "pnpm --dir functions test",
    "check": "pnpm run build && pnpm run test",
    "preview": "vite preview --host 0.0.0.0",
    "functions:serve": "npm --prefix functions run serve",
    "functions:deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
